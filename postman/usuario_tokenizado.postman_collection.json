{
	"info": {
		"_postman_id": "f583e742-83b6-4e59-a58f-2873105432d1",
		"name": "Usuario Tokenizado API",
		"description": "Colección de Postman para interactuar con la API de usuarios y tokens en Laravel.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Obtener 10 primeros usuarios",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/users",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"users"
					]
				},
				"description": "Obtiene la lista de los 10 primeros usuarios registrados."
			},
			"response": []
		},
		{
			"name": "2. Crear usuario",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Usuario Ejemplo\",\n  \"email\": \"usuario@example.com\",\n  \"password\": \"password123\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/users",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"users"
					]
				},
				"description": "Crea un nuevo usuario con la contraseña hasheada."
			},
			"response": []
		},
		{
			"name": "3. Iniciar Sesión (Login)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"usuario@example.com\",\n  \"password\": \"password123\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"login"
					]
				},
				"description": "Verifica credenciales y retorna el token de sesión generado."
			},
			"response": []
		},
		{
			"name": "4. Actualizar Nombre por Token",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"token\": \"TU_TOKEN_GENERADO_EN_LOGIN\",\n  \"name\": \"Nuevo Nombre de Usuario\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/users/name",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"users",
						"name"
					]
				},
				"description": "Actualiza el nombre del usuario validando únicamente su token activo."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000",
			"type": "string"
		}
	]
}
